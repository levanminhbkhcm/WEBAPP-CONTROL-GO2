[Unit]
Description=Unitree MQTT bridge on Jetson
After=NetworkManager.service network-online.target
Wants=NetworkManager.service network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson
Environment=LD_LIBRARY_PATH=/usr/local/lib:/opt/unitree_robotics/lib
ExecStart=/usr/local/bin/unitree_mqtt_bridge --robot r1 --network-interface eth0 --broker-url wss://broker.emqx.io:8084/mqtt --topic-prefix unitree/cdvd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
